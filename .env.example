# OpenAI-compatible chat model configuration.
# Defaults below use Alibaba Cloud Model Studio (China/Beijing).
OPENAI_API_KEY=
OPENAI_MODEL=qwen-plus
OPENAI_SECONDARY_MODEL=qwen-turbo
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# To use OpenAI instead, set an OpenAI API key and use, for example:
# OPENAI_MODEL=gpt-4o
# OPENAI_SECONDARY_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: enable LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TRACING_V2=false
LANGSMITH_PROJECT=langchain-academy
# Uncomment when using the LangSmith EU instance:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Required for the web-search lessons in module 4
TAVILY_API_KEY=
